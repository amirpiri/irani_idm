{
  "productName": "Irani IDM",
  "version": "1.7.1",
  "identifier": "com.iranidm.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Irani IDM", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600, "visible": false, "transparent": true }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["iranidm"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
