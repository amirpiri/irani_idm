{
  "manifest_version": 3,
  "name": "Irani IDM Browser Integration",
  "version": "1.0.1",
  "description": "Send browser downloads to Irani IDM.",
  "homepage_url": "https://github.com/amirpiri/irani_idm",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Irani IDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "permissions": ["downloads", "storage", "nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
